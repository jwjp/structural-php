{
  "name": "jiwonio/structural-php",
  "description": "A dependency-free PHP framework built from scratch to study a DI container, middleware pipeline, template engine and migrations",
  "license": "Unlicense",
  "type": "project",
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "App\\system\\": "system/"
    }
  },
  "scripts": {
    "test": "@php tests/run.php",
    "test:mysql": "@php tests/mysql.php",
    "lint": "@php tests/lint.php",
    "migrate": "@php bin/migrate",
    "serve": "@php -S 127.0.0.1:8000 -t public public/index.php"
  },
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-ctype": "*"
  }
}
