# Disable directory listings.
Options -Indexes

# Hide server details when the host allows these directives in httpd.conf.
# ServerSignature Off
# ServerTokens Prod

# Protect hidden files such as .git, .gitignore and .env.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    # Enable URL rewriting.
    RewriteEngine On

    # Serve existing files and directories directly.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route application requests through the front controller.
    RewriteRule ^ index.php [L,QSA]
</IfModule>
